@startuml
title Flujo CU-03a: Restablecer Contraseña
skinparam activity {
  BackgroundColor LightCyan
  BorderColor DarkSlateGray
}
skinparam swimlane {
  BorderColor DarkSlateGray
  BorderThickness 2
}

|Administrador|
start
:Ir al panel de administración;

:Seleccionar "Gestionar Usuarios";

|Pantalla|
:Mostrar la lista de usuarios;

|Administrador|
:Ubicar el usuario;

:Seleccionar "Restablecer Contraseña";

|Pantalla|
:Pedir confirmación\n"La contraseña actual dejará de ser válida y se generará un enlace de activación";

|Administrador|
:Confirmar;

|Pantalla|
:Enviar la solicitud;

|Sistema|
:Invalidar la contraseña actual;

:Generar un enlace temporal de activación (24 horas);

|Pantalla|
:Mostrar el enlace de activación;

:Abrir la página de configuración en una ventana nueva;

|Usuario|
:Definir su nueva contraseña con el enlace;

:Ingresar al sistema;

stop

@enduml
