@startuml
title Diagrama General - Casos de Uso del Sistema Zone Control
skinparam usecase {
  BackgroundColor LightCyan
  BorderColor DarkSlateGray
}
skinparam actorStyle awesome
skinparam packageStyle rectangle
left to right direction

' =============================================
' ACTORES
' =============================================

actor "Usuario Autenticado" as Auth #BDBDBD
actor "Público General" as Publico #LightBlue
actor "Administrador" as Admin #LightGreen
actor "Gestor de Personal" as Gestor #LightYellow
actor "Personal / Empleado" as Empleado #LightCoral
actor "Supervisor / Auditor" as Supervisor #LightPink
actor "Socio Internacional" as Socio #Wheat

' =============================================
' HERENCIA (actores autenticados heredan de Auth)
' =============================================

Admin --|> Auth
Gestor --|> Auth
Supervisor --|> Auth

note right of Auth
  Autenticación JWT.
  Admin, Gestor y Supervisor
  heredan la capacidad de
  iniciar sesión (CU-02).
end note

' =============================================
' MÓDULOS (apilados verticalmente, ordenados
' según el actor que los usa para evitar cruces)
' =============================================

package "Módulo de Autenticación" as ModuloAutenticacion #E3F2FD {
  usecase "CU-02: Iniciar sesión JWT" as UC_LOGIN
}

Auth --> UC_LOGIN

ModuloAutenticacion -[hidden]down- ModuloPublico

package "Módulo Público" as ModuloPublico #E8F5E9 {
  usecase "CU-01: Consultar información institucional" as UC01
  usecase "CU-01a: Consultar datos de contacto" as UC01a
  usecase "CU-01b: Consultar ubicación de sedes" as UC01b
  usecase "CU-01c: Descargar folleto informativo" as UC01c
  usecase "CU-01d: Consultar catálogo de servicios/productos" as UC01d
  UC01 ..> UC01c : <<extend>>
}

Publico --> UC01
Publico --> UC01a
Publico --> UC01b
Publico --> UC01c
Publico --> UC01d

ModuloPublico -[hidden]down- ModuloAdmin

package "Módulo de Administración" as ModuloAdmin #FFF3E0 {
  usecase "CU-03a: CRUD de usuarios del sistema" as UC03a
  usecase "CU-03b: Gestionar contenido del módulo público" as UC03b
  usecase "CU-03c: Gestionar matriz de roles y permisos" as UC03c
}

Admin --> UC03a
Admin --> UC03b
Admin --> UC03c

note right of UC03a
  Prerrequisito: CU-04 debe
  ejecutarse antes. El User
  requiere un Employee existente
  (relación @OneToOne).
end note

ModuloAdmin -[hidden]down- ModuloGestion

package "Módulo de Gestión de Personal" as ModuloGestion #F3E5F5 {
  usecase "CU-04: Registrar personal y asignar departamento" as UC04
  usecase "CU-05: Carga masiva (Archivo plano)" as UC05
  usecase "CU-05a: Validar estructura e información" as UC05a
  usecase "CU-06: Gestionar permisos (Otorgar/Revocar/Suspender)" as UC06
  usecase "CU-07: Buscar personal por filtros" as UC07
  usecase "CU-07a: Editar empleado y cambiar estado" as UC07a
  UC05 ..> UC05a : <<include>>
  UC07a ..> UC07 : <<include>>
}

Gestor --> UC04
Gestor --> UC05
Gestor --> UC06
Gestor --> UC07
Gestor --> UC07a

ModuloGestion -[hidden]down- ModuloAcceso

package "Módulo de Control de Acceso Físico" as ModuloAcceso #FFEBEE {
  usecase "CU-11: Solicitar y validar acceso a área restringida" as UC11
  usecase "CU-11a: Validar lectura de credencial" as UC11a
  usecase "CU-11b: Validar estado (autorizado/denegado/no registrado/suspendido)" as UC11b
  usecase "CU-11c: Registrar historial del intento" as UC11c
  UC11 ..> UC11a : <<include>>
  UC11 ..> UC11b : <<include>>
  UC11 ..> UC11c : <<include>>
}

Empleado --> UC11
Supervisor --> UC11

ModuloAcceso -[hidden]down- ModuloReportes

package "Módulo de Reportes y Auditoría" as ModuloReportes #E0F7FA {
  usecase "CU-08: Consultar historial de accesos por fechas" as UC08
  usecase "CU-09: Generar documento descargable del historial" as UC09
  usecase "CU-10: Generar archivo periódico por departamentos" as UC10
  UC09 ..> UC08 : <<include>>
}

Supervisor --> UC08
Supervisor --> UC09
Supervisor --> UC10

UC10 --> Socio

@enduml
