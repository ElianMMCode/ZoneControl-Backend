@startuml
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor DarkSlateGray
}
skinparam actorStyle awesome
skinparam packageStyle rectangle
left to right direction

actor "Gestor de Personal" as Gestor #LightYellow

package "Módulo de Gestión de Personal" {
    usecase "CU-04: Registrar personal" as UC_Gest1
    usecase "CU-05: Cargar personal de forma masiva" as UC_Gest2
    usecase "CU-06: Gestionar permisos de acceso (otorgar, editar, suspender, reactivar, revocar)" as UC_Gest4
    usecase "CU-06a: Gestionar las áreas de producción" as UC_Gest7
    usecase "CU-06b: Definir turnos y horarios por día" as UC_Gest9
    usecase "CU-07: Buscar personal" as UC_Gest5
    usecase "CU-07a: Editar datos del empleado y cambiar su estado" as UC_Gest6
    usecase "CU-07b: Consultar el detalle del empleado" as UC_Gest8
}

Gestor --> UC_Gest1
Gestor --> UC_Gest2
Gestor --> UC_Gest4
Gestor --> UC_Gest5
Gestor --> UC_Gest6
Gestor --> UC_Gest7
Gestor --> UC_Gest8
Gestor --> UC_Gest9

note bottom of UC_Gest1
  Al registrar a un empleado se puede
  adjuntar una fotografía (opcional).
end note

note bottom of UC_Gest2
  La carga masiva valida cada fila del
  archivo e informa los errores de
  forma clara. El archivo tiene un
  tamaño máximo permitido.
end note

note bottom of UC_Gest4
  Solo puede existir un permiso por
  empleado y área. Un permiso solo se
  puede editar si está activo; la
  suspensión y reactivación son manuales.
end note

note bottom of UC_Gest7
  El catálogo de áreas también está
  disponible en el panel del
  administrador.
end note

note bottom of UC_Gest9
  Cada permiso puede tener horarios
  distintos por día de la semana.
end note

note bottom of UC_Gest8
  Muestra la ficha del empleado con su
  fotografía, sus permisos de acceso y
  su historial de accesos.
end note

@enduml
