@startuml
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor DarkSlateGray
}
skinparam packageStyle rectangle
left to right direction

actor "Gestor de Personal" as Gestor #LightYellow

package "Módulo de Gestión de Personal" {
    usecase "CU-04: Registrar personal y asignar departamento" as UC_Gest1
    usecase "CU-05: Carga masiva (Archivo plano)" as UC_Gest2
    usecase "CU-05a: Validar estructura e información" as UC_Gest3
    usecase "CU-06: Gestionar permisos (Otorgar/Editar/Suspender/Reactivar/Revocar)" as UC_Gest4
    usecase "CU-06a: Gestionar áreas de producción" as UC_Gest7
    usecase "CU-06b: Turnos y horarios por día" as UC_Gest9
    usecase "CU-07: Buscar personal por filtros" as UC_Gest5
    usecase "CU-07a: Editar empleado y cambiar estado" as UC_Gest6
    usecase "CU-07b: Fotografía del empleado" as UC_Gest8

    UC_Gest2 ..> UC_Gest3 : <<include>>
    UC_Gest6 ..> UC_Gest5 : <<include>>
}

Gestor --> UC_Gest1
Gestor --> UC_Gest2
Gestor --> UC_Gest4
Gestor --> UC_Gest5
Gestor --> UC_Gest6
Gestor --> UC_Gest7
Gestor --> UC_Gest8
Gestor --> UC_Gest9

note bottom of UC_Gest4
  POST /api/permisos (Otorgar)
  PATCH /api/permisos/{id} (Editar)
  PATCH /api/permisos/{id}/suspend
  PATCH /api/permisos/{id}/reactivate
  DELETE /api/permisos/{id}
end note

note bottom of UC_Gest7
  POST/PUT/DELETE /api/permisos/areas
  Implementado backend; frontend
  en /admin/areas (admin)
end note

note bottom of UC_Gest8
  POST/GET/DELETE /api/personal/{id}/photo
  Implementado backend y frontend
end note

note bottom of UC_Gest9
  PermissionSchedule LUN..DOM
  Implementado (3.2 §9)
end note

@enduml
