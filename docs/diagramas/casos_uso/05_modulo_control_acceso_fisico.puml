@startuml
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor DarkSlateGray
}
skinparam actorStyle awesome
skinparam packageStyle rectangle
left to right direction

actor "Supervisor / Auditor" as Sup #LightPink

package "Módulo de Control de Acceso Físico" {
    usecase "CU-11: Registrar la entrada a un área restringida" as UC_Acc1
    usecase "CU-11a: Registrar la salida de un área" as UC_Acc2
    usecase "CU-11b: Consultar la ocupación en tiempo real de cada zona" as UC_Acc3
    usecase "CU-11c: Cerrar o reabrir una zona por emergencia" as UC_Acc4
    usecase "CU-11d: Consultar alertas de anomalías de acceso" as UC_Acc5
    usecase "CU-11e: Consultar el personal asignado y las autorizaciones de una sala" as UC_Acc6
}

Sup --> UC_Acc1
Sup --> UC_Acc2
Sup --> UC_Acc3
Sup --> UC_Acc4
Sup --> UC_Acc5
Sup --> UC_Acc6

note bottom of UC_Acc1
  El sistema verifica si la persona
  tiene permiso y está dentro del
  horario permitido, y registra cada
  intento. Si la zona está cerrada por
  emergencia, se deniega el ingreso.
end note

note bottom of UC_Acc2
  Cierra la sesión activa del empleado
  en la zona y queda registrada la salida.
end note

note bottom of UC_Acc3
  Muestra cuántas personas hay dentro
  de cada zona y quiénes están.
end note

note bottom of UC_Acc5
  Alertas por denegaciones repetidas o
  por cierre de zona por emergencia.
  Se pueden marcar como revisadas.
end note

note bottom of UC_Acc6
  Empleados asignados a la sala y sus
  autorizaciones (vigencia, horario y
  turnos por día).
end note

@enduml
