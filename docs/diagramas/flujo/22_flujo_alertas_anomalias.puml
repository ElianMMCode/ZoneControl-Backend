@startuml
title Flujo CU-11d: Alertas de Anomalías de Acceso
skinparam activity {
  BackgroundColor LightCyan
  BorderColor DarkSlateGray
}
skinparam swimlane {
  BorderColor DarkSlateGray
  BorderThickness 2
}

|Sistema|
start
:Registrar un intento de acceso;

if (¿Hay 3 o más denegaciones del mismo empleado en 15 minutos?) then (Sí)
  :Crear una alerta de "denegaciones repetidas";
elseif (¿Se cerró o reabrió una zona por emergencia?) then (Sí)
  :Crear una alerta de "emergencia de zona";
else (No)
  :No se crea ninguna alerta;
endif

:Guardar la alerta;

:Mostrarla en el panel en tiempo real;

|Supervisor / Auditor|
:Ver la alerta en el panel de "Zonas en vivo";

|Administrador|
:Ver la alerta en el panel "Alertas de seguridad" del panel de administración;

:Revisarla y marcarla como leída;

|Sistema|
:Guardar la alerta como leída;

stop

@enduml
