@startuml
title Flujo CU-08: Consultar Historial
skinparam activity {
  BackgroundColor LightCyan
  BorderColor DarkSlateGray
}
skinparam swimlane {
  BorderColor DarkSlateGray
  BorderThickness 2
}

|Supervisor / Auditor|
start
:Acceder a "Reportes y Auditoría";

:Seleccionar "Consultar Historial";

|Frontend|
:Pantalla: Formulario de consulta;

|Supervisor / Auditor|
:Seleccionar rango de fechas;

:Aplicar filtros opcionales\n(empleado, departamento, resultado);

:Presionar "Consultar";

|Frontend|
:Validar rango de fechas;

if (¿Fechas válidas?) then (Sí)
  :Enviar GET\n(fechaInicio, fechaFin, employeeCode,\ndepartment, resultado);

  |Backend|
  :Consultar historial en PostgreSQL\ncon predicados AND;

  :Retornar registros;

  |Frontend|
  :Pantalla: Tabla de historial;

  :Opción: Exportar;

else (No)
  :Pantalla: Error "Rango inválido";

endif

note right
  Filtro por departamento (gap 1.3 §9,
  implementado): GET /api/historial?department=
  y ExportRequest.departamentoName.
end note

stop

@enduml
