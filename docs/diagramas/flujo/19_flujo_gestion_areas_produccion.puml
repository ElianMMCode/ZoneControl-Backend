@startuml
title Flujo CU-06a: Gestionar Áreas de Producción
skinparam activity {
  BackgroundColor LightCyan
  BorderColor DarkSlateGray
}
skinparam swimlane {
  BorderColor DarkSlateGray
  BorderThickness 2
}

|Gestor de Personal / Administrador|
start
:Ir a "Áreas de Producción";

|Pantalla|
:Mostrar el listado de áreas;

|Gestor de Personal / Administrador|
split
  :Crear un área;
  |Pantalla|
  :Mostrar el formulario (nombre de hasta 30 caracteres y descripción);
  :Enviar la solicitud;
  |Sistema|
  if (¿El nombre está disponible?) then (Sí)
    :Crear el área;
  else (No)
    :Informar que ya existe un área con ese nombre;
    |Pantalla|
    :Mostrar el error;
  endif
split again
  :Editar un área;
  |Pantalla|
  :Mostrar el formulario con los datos actuales;
  :Enviar la solicitud;
  |Sistema|
  if (¿El área existe?) then (Sí)
    :Actualizar el área;
  else (No)
    :Informar que el área no existe;
  endif
split again
  :Eliminar un área;
  |Pantalla|
  :Pedir confirmación;
  :Enviar la solicitud;
  |Sistema|
  if (¿El área tiene permisos activos asociados?) then (No)
    :Eliminar el área;
  else (Sí)
    :Informar que no se puede eliminar porque tiene permisos activos;
    |Pantalla|
    :Mostrar el error;
  endif
end split

note right
  El historial conserva el nombre del área
  aunque se renombre. La gestión de áreas
  también está en el panel del administrador.
end note

stop

@enduml
