@startuml
title Flujo CU-06: Suspender Acceso
skinparam activity {
  BackgroundColor LightCyan
  BorderColor DarkSlateGray
}
skinparam swimlane {
  BorderColor DarkSlateGray
  BorderThickness 2
}

|Gestor de Personal|
start
:Acceder a "Gestionar Permisos";

:Buscar empleado por ID o nombre;

|Backend|
:Consultar PostgreSQL;

:Retornar resultados;

|Gestor de Personal|
:Seleccionar empleado;

:Seleccionar "Suspender Acceso";

|Frontend|
:Pantalla: Permisos activos del empleado;

|Gestor de Personal|
:Seleccionar permiso a suspender;

:Definir fecha de reactivación;

:Enviar PATCH /api/permisos/{id}/suspend;

|Backend|
:Actualizar estado a "suspendido";

:Guardar fecha de reactivación;

:Retornar HTTP 200;

|Gestor de Personal|
:Confirmar suspensión;

split
  :(Opcional) Reactivar permiso\nantes de la fecha programada;
  :Enviar PATCH\n/api/permisos/{id}/reactivate;
  |Backend|
  :Estado → ACTIVO;\nlimpiar fechaReactivacion;
  |Gestor de Personal|
  :Confirmar reactivación;
split again
  :(Opcional) Editar fechas/horarios;
  :Enviar PATCH /api/permisos/{id};
end split

note right
  NO hay auto-reactivación
  (@Scheduled). La reactivación
  es manual (PATCH /reactivate)
  o por cascade al reactivar el
  empleado.
end note

stop

@enduml
